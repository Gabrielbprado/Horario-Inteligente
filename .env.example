# ------------------------------------------------------------------- backend
# SQLite para desenvolvimento; o docker-compose sobrescreve com PostgreSQL.
DATABASE_URL=sqlite+pysqlite:///./horario.db
# DATABASE_URL=postgresql+psycopg://horario:horario@db:5432/horario

# Origens permitidas pelo CORS (separadas por virgula)
CORS_ORIGINS=http://localhost:5173

# --------------------------------------------------------------- OpenAI (chat)
# Sem estas duas variaveis o sistema funciona normalmente e o painel de chat
# mostra "Chat desativado: configure a chave".
# O nome do modelo NUNCA e fixado no codigo: consulte a documentacao atual da
# OpenAI e escolha o modelo recomendado para function calling.
OPENAI_API_KEY=
OPENAI_MODEL=

# ------------------------------------------------------- PostgreSQL (compose)
POSTGRES_USER=horario
POSTGRES_PASSWORD=horario
POSTGRES_DB=horario

# ------------------------------------------------------------------ frontend
# Em dev o Vite faz proxy de /api para o backend; so defina se for apontar direto.
# VITE_API_URL=http://localhost:8000
